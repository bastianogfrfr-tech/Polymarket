# Copy to .env and fill in. NEVER commit .env or paste the key anywhere.

# --- Safety: keep true until you have watched dry runs for a while ---
DRY_RUN=true
DRY_RUN_BANKROLL=10

# --- Wallet (only needed for DRY_RUN=false) ---
# Use a fresh wallet that only holds the money you are willing to lose.
PRIVATE_KEY=
# Your Polymarket profile/proxy address (shown under your profile picture on polymarket.com)
FUNDER_ADDRESS=
# 1 = email/Magic login, 2 = browser wallet (MetaMask etc.), 0 = plain EOA
SIGNATURE_TYPE=1

# --- Limits ---
MAX_STAKE=2
STOP_BALANCE=5
MAX_TRADES_PER_DAY=5
KELLY_FRACTION=0.25

# --- Strategy ---
MIN_EDGE=0.08
MIN_PROB=0.55
MAX_PRICE=0.95
MIN_LOCAL_HOUR=14
MAX_HOURS_TO_PEAK=1
